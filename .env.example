# =============================================================================
#  App
# =============================================================================
APP_NAME="My App"
# dev | prod  — controls debug, docs exposure, cookie Secure flag defaults
ENV=dev
# Bumped on every deploy; appended to static assets as ?v=DEPLOY_VERSION
DEPLOY_VERSION=1
# Public base URL (used to build Stripe success/cancel URLs, email links, etc.)
BASE_URL=http://localhost:8000

# =============================================================================
#  Security  (generate with:  python -c "import secrets;print(secrets.token_hex(32))")
# =============================================================================
SECRET_KEY=change-me-dev-only-use-openssl-rand-hex-32
# Optional: separate key for encrypting third-party secrets at rest (Fernet / BYOK).
# Leave blank to derive from SECRET_KEY.
ENCRYPTION_KEY=

# JWT
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
# Cookie the session token is stored in
SESSION_COOKIE_NAME=session
# Force the Secure flag on cookies (auto-on when ENV=prod). 0/1
SECURE_COOKIE=0
# Set to your apex domain for cross-subdomain SSO, e.g. .example.com  (blank = host-only)
COOKIE_DOMAIN=

# =============================================================================
#  Database
#  SQLite (default, zero-config):  sqlite+aiosqlite:///./app.db
#  Postgres:                       postgresql+asyncpg://user:pass@host:5432/dbname
# =============================================================================
DATABASE_URL=sqlite+aiosqlite:///./app.db
# Optional read replica; reads route here, writes to DATABASE_URL. Blank = single DB.
DATABASE_READ_URL=
SQL_ECHO=0

# =============================================================================
#  Redis (optional)  — enables cross-worker rate limiting & caching.
#  Leave blank to use in-memory (fine for a single worker).
# =============================================================================
REDIS_URL=

# =============================================================================
#  Rate limiting
# =============================================================================
RATE_LIMIT_ENABLED=1
# Default limit applied to sensitive endpoints: N requests per WINDOW seconds
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW=60

# =============================================================================
#  Security headers / CSP
# =============================================================================
SECURITY_HEADERS_ENABLED=1
HSTS_ENABLED=0
# Extra hosts allowed in CSP (space-separated), e.g. https://cdn.example.com
CSP_EXTRA_SCRIPT_SRC=
CSP_EXTRA_STYLE_SRC=
CSP_EXTRA_CONNECT_SRC=
# Comma-separated allowed CORS origins (blank = same-origin only)
CORS_ORIGINS=

# =============================================================================
#  Registration / accounts
# =============================================================================
REGISTRATION_ENABLED=1
# Require email verification before login is allowed. 0/1
REQUIRE_EMAIL_VERIFICATION=0
# The first user to register is granted the admin role. 0/1
FIRST_USER_IS_ADMIN=1
# Comma-separated emails always treated as admin (bootstrap escape hatch)
ADMIN_EMAILS=
# Credits granted to a new account on signup
WELCOME_CREDITS=0

# =============================================================================
#  Email (SMTP).  If SMTP_HOST is blank, emails are logged to the console.
# =============================================================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=1
EMAIL_FROM="My App <no-reply@example.com>"

# =============================================================================
#  Stripe
# =============================================================================
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Stripe Customer Portal config id (optional; blank uses account default)
STRIPE_PORTAL_CONFIGURATION_ID=

# =============================================================================
#  Object storage (avatars, ticket attachments).
#  STORAGE_BACKEND=local keeps files on disk (public -> /static/uploads, private
#  streamed via signed links). Set STORAGE_BACKEND=s3 for AWS S3 / Cloudflare R2 /
#  MinIO / Backblaze (S3-compatible).
# =============================================================================
STORAGE_BACKEND=local
S3_ENDPOINT_URL=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BUCKET=
S3_PRIVATE_BUCKET=
# Serve the public bucket through your own CDN domain (blank = direct bucket URL)
S3_PUBLIC_CDN_URL=
S3_FORCE_PATH_STYLE=0
UPLOAD_MAX_MB=10

# =============================================================================
#  Bot protection (Cloudflare Turnstile) — both keys required to enable
# =============================================================================
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# =============================================================================
#  Social OAuth (each provider needs both id + secret to appear)
#  Callback URLs to register:  {BASE_URL}/auth/{provider}/callback
# =============================================================================
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=

# =============================================================================
#  Background scheduler (APScheduler): session cleanup, subscription dunning
# =============================================================================
SCHEDULER_ENABLED=0
SESSION_RETENTION_DAYS=30

# =============================================================================
#  Ops (all optional)
# =============================================================================
SENTRY_DSN=
# Telegram alerts for 500s (both required to enable)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
LOG_LEVEL=INFO
LOG_DIR=logs

# =============================================================================
#  Account lifecycle
# =============================================================================
# Days between "delete my account" and the irreversible purge (scheduler job).
ACCOUNT_DELETION_GRACE_DAYS=30

# =============================================================================
#  Security hardening
# =============================================================================
# Email the user when a sign-in comes from a device/IP we haven't seen before.
LOGIN_ALERTS_ENABLED=1
# Reject passwords found in the Have I Been Pwned corpus (k-anonymity: only a
# 5-char SHA-1 prefix leaves the server; fails open if the API is unreachable).
HIBP_ENABLED=1
# Bump to force every user to re-accept the terms on next sign-in.
TERMS_VERSION=1

# =============================================================================
#  Billing / tax  (requires Stripe Tax to be enabled in the dashboard)
# =============================================================================
STRIPE_TAX_ENABLED=0
INVOICE_COMPANY_NAME=
INVOICE_COMPANY_ADDRESS=
INVOICE_TAX_ID=

# =============================================================================
#  Ops: metrics, status, backups
# =============================================================================
METRICS_ENABLED=1
# Blank = /metrics is open. Set a token (sent as `Authorization: Bearer …`) or
# block the path at your reverse proxy.
METRICS_TOKEN=
# scripts/backup_db.py defaults — run it from cron.
BACKUP_DIR=backups
BACKUP_KEEP_DAYS=14

# =============================================================================
#  Analytics & cookie consent
# =============================================================================
# The script is injected only after the visitor accepts cookies.
ANALYTICS_SCRIPT_URL=
ANALYTICS_SITE_ID=
COOKIE_BANNER_ENABLED=1

# =============================================================================
#  i18n — catalogues live in app/locales/<code>.json
# =============================================================================
DEFAULT_LOCALE=en
AVAILABLE_LOCALES=en,es

# =============================================================================
#  SEO (OpenGraph / Twitter cards)
# =============================================================================
SITE_DESCRIPTION=
# Absolute URL, e.g. https://example.com/static/img/og.png
SITE_IMAGE=

# =============================================================================
#  Referrals
# =============================================================================
REFERRALS_ENABLED=1
# Credits given to the referrer when someone they referred signs up (0 = off).
REFERRAL_BONUS_CREDITS=0
